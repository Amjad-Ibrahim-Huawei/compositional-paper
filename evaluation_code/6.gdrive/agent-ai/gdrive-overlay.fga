  model
  schema 1.1

    ########################################
    # Identities (domain + overlay)
    ########################################
    type user
      relations
        # human → agent delegation (root)
        define delegatee: [agent, agent with temporal_delegation, agent with conditional_delegation]
        define can_execute_on_my_behalf: delegatee or can_execute_on_my_behalf from delegatee

    type group
      relations
        define member: [user]
        define can_execute_on_my_behalf: can_execute_on_my_behalf from member

    type agent
      relations
        # agent → agent delegation
        define delegatee: [agent, agent with temporal_delegation, agent with conditional_delegation]
        define can_execute_on_my_behalf: delegatee or can_execute_on_my_behalf from delegatee

    type session
      relations
        define actor: [agent]
        define as_agent: actor

    type scope
      relations
        define parent: [scope]
        define holder: [session, session with temporal_access]
        define sessions: holder or sessions from parent
        define agents_direct: as_agent from holder
        define agents: agents_direct or agents from parent

   type folder
      relations
        define can_create_file: owner
        define owner: [user]
        define parent: [folder]
        define viewer: [user]
        # --- CHANGED: move group membership expansion to the object side
        #              instead of putting `group#member` directly in `viewer`.
        define group_viewer: [group]
        # --- CHANGED: user-typed viewerset; expands groups via `member from group_viewer`.
        define can_view_human: viewer or owner or member from group_viewer or viewer from parent or delegated_agent_viewer
        
        define in_scope: [scope]
             # --- Agents who have valid sessions in-scope (A) ---
      define agents_in_scope: agents from in_scope
      
      #     We lift human viewers/editors/owners through the chain, with parent recursion.
      define chain_agents_for_view: can_execute_on_my_behalf from viewer or can_execute_on_my_behalf from owner or chain_agents_for_view from parent  or can_execute_on_my_behalf from group_viewer
      # Intersection(A, B) using "but not"
     define delegated_agent_viewer: agents_in_scope and chain_agents_for_view
          # Final permissions (subject can be user or agent)
    
      define can_view: can_view_human or delegated_agent_viewer
      
 
       

  type doc
    relations
      define can_share: owner or owner from parent
      define can_write: owner or owner from parent

      define owner: [user]
      define parent: [folder]
      # --- CHANGED: direct viewers are user-typed and derived from folder.viewer_user
       define viewer: [user]
      # --- CHANGED: doc viewers are user-typed and derived from folder.viewer_user
      define group_viewer: [group]
      # --- CHANGED: user-typed viewerset
       
      define can_change_owner: owner
      define human_viewer: viewer or member from group_viewer  or owner or can_view_human from parent
      
      
      # --- ADDED (R1): inherit envelope/active agents from parent folder
      define agents_in_scope: agents_in_scope from parent

      # --- ADDED (R2): delegation chain lift (recurse to folder via parent)
      define chain_agents_for_view:  can_execute_on_my_behalf from viewer  or can_execute_on_my_behalf from group_viewer or can_execute_on_my_behalf from owner  or chain_agents_for_view from parent

      # --- ADDED (R3): intersection gate (envelope ∩ delegation)
      define delegated_agent_viewer: agents_in_scope and chain_agents_for_view

    # --- ADDED (R4): agent injection into read
    # (Humans unchanged; agents join via delegated_agent_viewer)
    # NOTE: doc.can_read already includes viewer/owner/parent; agents come via delegated_agent_viewer:
    # You can either leave can_read as domain-only and rely on can_view on folder,
    # OR explicitly union here if you check doc.can_read directly for agents:
    define can_read: human_viewer or delegated_agent_viewer

    ########################################
    # Guards
    ########################################
    condition temporal_access(expires_at: timestamp, current_time: timestamp) {
      current_time < expires_at
    }
    condition temporal_delegation(expires_at: timestamp, current_time: timestamp) {
      current_time < expires_at
    }
    condition conditional_delegation(allowed_purposes: list<string>, purpose: string) {
      purpose in allowed_purposes
    }
